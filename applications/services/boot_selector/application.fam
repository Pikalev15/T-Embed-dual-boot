App(
    appid="boot_selector",
    name="DualBootSelector",
    apptype=FlipperAppType.STARTUP,
    entry_point="boot_selector_startup",
    requires=[
        "gui",
        "input",
        "desktop",
    ],
    # Run after the normal services have started. Startup hooks execute
    # synchronously, so the selector remains in front until dismissed.
    order=210,
)
